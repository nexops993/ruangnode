# ---------------------------------------------------------------------------
# RuangNode environment configuration (EXAMPLE ONLY)
#
# Copy this file to `.env` and fill in real values locally.
#   cp .env.example .env
#
# Rules:
#   - `.env` is git-ignored. Never commit real credentials.
#   - Values here are intentionally empty or non-secret placeholders.
#   - Secrets must come from the environment or a secret manager, never code.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Public web application (apps/web) -------------------------------------
WEB_APP_URL=http://localhost:3000

# --- Control plane API (apps/api) ------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001

# --- PostgreSQL (packages/database, control plane) -------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The Prisma CLI and the development seed read this file through
# packages/database/prisma.config.ts (Prisma 7 no longer loads .env itself).
DATABASE_URL=

# --- Sessions --------------------------------------------------------------
# Required. Signs the session cookie and must be at least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Absolute session lifetime in hours (default: 720 = 30 days).
SESSION_TTL_HOURS=
# Password-reset token lifetime in minutes (default: 60).
PASSWORD_RESET_TTL_MINUTES=
# Force the Secure cookie flag. Defaults to true when NODE_ENV=production.
# Set to false only for a local HTTP development setup.
SESSION_COOKIE_SECURE=

# --- Redis (optional: queues, rate limiting, transient state) --------------
# Only required once asynchronous jobs are introduced.
REDIS_URL=

# --- Payment providers (adapter-based, added in a later phase) -------------
# Provider-specific credentials are supplied per adapter, never hard-coded.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- Node Agent (outbound authenticated agent -> control plane channel) ----
NODE_AGENT_ID=
NODE_AGENT_CONTROL_PLANE_URL=
NODE_AGENT_SHARED_SECRET=

# --- Object storage for digital product delivery ---------------------------
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
