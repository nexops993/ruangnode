{
  "name": "@ruangnode/node-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted agent running on infrastructure nodes; owns the Docker runtime.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
