# RuangNode node agent example
NODE_ENV=production
NODE_AGENT_ID=node-01
NODE_AGENT_HOST=0.0.0.0
NODE_AGENT_PORT=9443
NODE_AGENT_CONTROL_PLANE_URL=https://api.ruangnode.example
NODE_AGENT_SHARED_SECRET=replace-with-a-long-random-secret
DOCKER_HOST=unix:///var/run/docker.sock

# Optional TLS termination for the agent endpoint when exposed directly.
NODE_AGENT_TLS_CERT=
NODE_AGENT_TLS_KEY=
LOG_LEVEL=info
