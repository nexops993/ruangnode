{
  "name": "@ruangnode/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema, migrations and typed client for the RuangNode control plane.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:seed": "prisma db seed",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
