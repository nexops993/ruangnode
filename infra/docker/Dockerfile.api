FROM node:22-alpine

WORKDIR /workspace

ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@12.8.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/services/package.json ./packages/services/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY node-agent/package.json ./node-agent/package.json

RUN corepack pnpm install --frozen-lockfile

COPY . .

RUN corepack pnpm --filter @ruangnode/database run prisma:generate
RUN corepack pnpm --filter @ruangnode/api run typecheck

EXPOSE 3001
CMD ["corepack", "pnpm", "--dir", "apps/api", "start"]
