# RuangNode control-plane API example
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# PostgreSQL connection for Prisma and the control plane
# Example: postgresql://ruangnode:ruangnode@localhost:5432/ruangnode?schema=public
DATABASE_URL=postgresql://ruangnode:ruangnode@localhost:5432/ruangnode?schema=public

# Authentication and session security
SESSION_SECRET=replace-with-at-least-32-characters
SESSION_TTL_HOURS=720
PASSWORD_RESET_TTL_MINUTES=60
SESSION_COOKIE_SECURE=false

# Authenticated Node Agent transport. Leave both unset to disable infrastructure routes.
NODE_AGENT_URL=http://node-agent.example.internal:9443
NODE_AGENT_TOKEN=replace-with-at-least-32-characters

# Observability
LOG_LEVEL=info
